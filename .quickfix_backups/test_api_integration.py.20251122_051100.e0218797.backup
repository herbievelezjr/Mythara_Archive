            headers={"Authorization": f"Bearer {VALID_API_KEY}"}
        )
        assert response.status_code == 200
        data = response.json()
        assert "soul_id" in data
        assert "will" in data
        assert "commandments" in data
        assert "antithesis" in data
    
    def test_soul_step(self):
