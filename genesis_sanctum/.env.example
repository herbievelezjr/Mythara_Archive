# Mythara Engine Pilot - Environment Configuration
# Copyright © 2025 Herbert Velez Jr. All rights reserved.

# ==============================================================================
# DEPLOYMENT MODE
# ==============================================================================
# Choose one:
# 1. Cloud-hosted (SaaS): Leave these empty, use API endpoint from email
# 2. Self-hosted: Fill these in and run docker-compose up

# ==============================================================================
# PILOT ACCESS (Required for self-hosted)
# ==============================================================================
MYTHARA_PILOT_PAYWALL=true
MYTHARA_PILOT_FORCE_UNLOCK=true
MYTHARA_PILOT_PURCHASE_URL=https://buy.stripe.com/28E9AU85SfFCa5MbucgjC01

# ==============================================================================
# STRIPE WEBHOOK (Only for self-hosted production)
# ==============================================================================
# Get this from: Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ==============================================================================
# API CONFIGURATION
# ==============================================================================
PORT=8000

# API Keys (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
MYTHARA_API_KEYS=sk_demo_key1,sk_demo_key2

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ==============================================================================
# NOTES
# ==============================================================================
# For pilot testing, set MYTHARA_PILOT_FORCE_UNLOCK=true
# This bypasses payment requirement for local testing
#
# For production self-hosted:
# - Set MYTHARA_PILOT_FORCE_UNLOCK=false
# - Set real STRIPE_WEBHOOK_SECRET
# - Generate unique API keys
